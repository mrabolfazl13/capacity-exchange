# Capacity Exchange backend — environment template (docs/CONTRACTS.md §11).
# Copy to backend/.env for local dev, or export in the shell.
# Dev DB: embedded pgserver on :5544 started by `python scripts/dev_db.py`.

DATABASE_URL=postgresql+psycopg://capacity:capacity@localhost:5544/capacity
SECRET_KEY=dev-secr…me-please
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
REDIS_URL=
CELERY_MODE=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
WEBHOOK_SECRET=dev-webhook-secret
DEFAULT_COMMISSION_BP=1000
APP_ENV=dev
PAYMENT_PROVIDER=mock
RATE_LIMIT_PER_MIN=120
APP_VERSION=0.1.0

# SMTP_* unset => email notifications become no-op records (CONTRACTS §11).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FRO…test
