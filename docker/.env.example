# docker/.env.example — variables consumed by docker-compose.yml / prod.yml
# interpolation. Copy to docker/.env (compose auto-loads it from the compose
# file's directory). Dev-safe defaults only; ZERO real secrets.
# The backend container additionally loads the repo-root .env.example via
# env_file (all CONTRACTS §11 names); values below override at the service level.

APP_ENV=dev
SECRET_KEY=dev-se…e-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
WEBHOOK_SECRET=***

# PostgreSQL container (also seeds the app DATABASE_URL inside compose)
POSTGRES_DB=capacity
POSTGRES_USER=capacity
POSTGRES_PASSWORD=***
POSTGRES_HOST_PORT=5432           # host port published by the DEV compose only

REDIS_HOST_PORT=6379              # host port published by the DEV compose only
BACKEND_HOST_PORT=8000

# Prod overlay (docker-compose.prod.yml)
# IMAGE_REGISTRY=ghcr.io/your-org   # set at deploy time; leave unset in dev
# WORKER_CONCURRENCY=2
