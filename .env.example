# Capacity Exchange — root environment template (CONTRACTS.md §11)
# Copy to .env for local use. ALL values here are dev-safe defaults.
# NEVER put real secrets in this file or in any committed .env.
#
# LOCAL DEV NOTE: this dev box has NO Docker and NO Redis. Keep REDIS_URL
# empty and CELERY_MODE=local; the backend must then use DB-only behaviour
# and the in-process job runner (backend/jobs/local_runner.py). Redis absence
# must never crash anything (CONTRACTS §10).

# --- Core (app.core.config, pydantic-settings) -------------------------------
# Dev default points at the pgserver database started by
# backend/scripts/dev_db.py (port 5544). In Docker Compose this is overridden
# to postgres://...@postgres:5432/capacity automatically.
DATABASE_URL=postgresql+psycopg://capacity:capacity@localhost:5544/capacity
SECRET_KEY=dev-se…e-me
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
APP_ENV=dev                       # dev | test | prod

# --- Redis / background jobs (optional Redis by design) -----------------------
REDIS_URL=                        # empty => DB-only behavior, no 500s
CELERY_MODE=local                 # local | celery (default local; no Redis here)
RATE_LIMIT_PER_MIN=120            # in-memory token bucket when REDIS_URL empty

# --- HTTP / CORS ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

# --- Money / payments ----------------------------------------------------------
WEBHOOK_SECRET=***        # HMAC shared secret for /payments/webhook
DEFAULT_COMMISSION_BP=1000        # 1000 bp = 10%
PAYMENT_PROVIDER=mock             # mock | bank_transfer | manual

# --- Email (all optional; unset SMTP_HOST => email notifications are
#     recorded as no-op rows, never sent, never error) ---------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FRO…test
SMTP_USE_TLS=true

# --- Docker Compose only (docker/docker-compose.yml interpolation) -------------
# Matches dev defaults; the app containers use service hostnames instead.
POSTGRES_DB=capacity
POSTGRES_USER=capacity
POSTGRES_PASSWORD=***
